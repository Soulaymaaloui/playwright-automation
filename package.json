  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.5.2",
    "allure-commandline": "^2.46.1"
  },
  "dependencies": {
    "allure-playwright": "^3.14.0",
    "mkdirp": "^3.0.1",
    "rimraf": "^6.1.3"
  }
}